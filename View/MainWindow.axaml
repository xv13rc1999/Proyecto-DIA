<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="TallerClientes.View.MainWindow"
        MinWidth="640" MinHeight="480"
        Width="800" Height="600"
        Title="Gestion de clientes">

        <DockPanel>
        <DockPanel DockPanel.Dock="Bottom">
            <Button Margin="10" DockPanel.Dock="Right" Name="btGuardar">Guardar</Button>
            <Button Margin="10" Name="btNuevo">Nuevo</Button>
            <Button Margin="10" Name="btEditar">Editar</Button>
            <Button Margin="10" Name="btEliminar">Eliminar</Button>
        </DockPanel>
        
        <ScrollViewer Margin="10">
            <ListBox Name="lbClientes"/>
        </ScrollViewer>
    </DockPanel>

</Window>
