<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Proyecto.View.ReparacionesView"
        Title="Gestión de Reparaciones - Taller de Coches"
        Width="900" Height="550"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, *, Auto" Margin="15">
        <!-- Barra de Filtros (Consultas) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <TextBlock Text="Filtrar por estado:" VerticalAlignment="Center" FontWeight="Bold"/>
            <ComboBox Name="cbFiltroEstado" Width="150" SelectedIndex="0">
                <ComboBoxItem>Todas</ComboBoxItem>
                <ComboBoxItem>Pendientes</ComboBoxItem>
                <ComboBoxItem>Terminadas</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <!-- Lista de Reparaciones -->
        <ListBox Grid.Row="1" Name="lbReparaciones" Margin="0,0,0,10"/>

        <!-- Botones de Acción (Altas, Bajas, Modificaciones) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Name="btnAlta" Content="Nueva Reparación" Padding="10,5"/>
            <Button Name="btnModificar" Content="Editar Seleccionada" Padding="10,5"/>
            <Button Name="btnBaja" Content="Eliminar" Padding="10,5" Background="DarkRed" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>