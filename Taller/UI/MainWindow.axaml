<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" Height="350"
        MinWidth="400" MinHeight="300"
        x:Class="Taller.UI.MainWindow"
        Title="Taller">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Salir" Name="OpSalir" />
            </MenuItem>
            <MenuItem Header="_Búsquedas">
                <MenuItem Header="_Clientes" Name="OpBuscaClientes" />
                <MenuItem Header="_Personal" Name="OpBuscaPersonal" />
                <MenuItem Header="_Reparaciones" Name="OpBuscaReparaciones" />
            </MenuItem>
        </Menu>

        <Label DockPanel.Dock="Bottom"
               Name="LblResumen"
               Margin="5" />

        <StackPanel Margin="20"
                    Orientation="Vertical"
                    VerticalAlignment="Center">
            <Button Name="BtBuscaClientes" Content="Buscar clientes"
                    Margin="5" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Button Name="BtBuscaPersonal" Content="Buscar personal"
                    Margin="5" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Button Name="BtBuscaReparaciones" Content="Buscar reparaciones"
                    Margin="5" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
        </StackPanel>

    </DockPanel>
</Window>
