<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:Taller.Utils.DTOs"
        xmlns:mc="clr-namespace:Taller.Views.Forms"
        x:Class="Taller.Views.Forms.FormularioPersonal"
        x:DataType="mc:FormularioPersonal"
        Title="Formulario personal" Width="300" Height="400"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Arial, sans-serif">

    <StackPanel>
        <StackPanel Spacing="10" Margin="20">
            <TextBlock Text="Dni:" />
            <TextBox Name="CampoDni" />

            <TextBlock Text="Nombre:" />
            <TextBox Name="CampoNombre" />

            <TextBlock Text="Email:" />
            <TextBox Name="CampoEmail" />

            <Border>
                <ListBox ItemsSource="{Binding SelectorReparaciones}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="u:SeleccionReparacionDTO">
                            <CheckBox Content="{Binding Asunto}" 
                                    IsChecked="{Binding Seleccionada}" 
                                    Margin="0,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Name="BtCancelar" Content="Cancelar" Background="#663668" />
            <Button Name="BtGuardar" Content="Guardar" Background="#663668" />
        </StackPanel>
    </StackPanel>
</Window>