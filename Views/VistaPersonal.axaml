<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="500" MinHeight="300"
        x:Class="Taller.Views.VistaPersonal"
        FontFamily="Segoe UI, Arial, sans-serif">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="5">
        <Label Grid.Row="0"
                Content="Gestión de Personal" 
                FontSize="24" 
                FontWeight="Bold" 
                Foreground="#1E293B" 
                Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Name="BtAnadir" Content="Añadir" Background="#663668"/>
            <Button Name="BtModificar" Content="Modificar" Background="#663668"/>
            <Button Name="BtEliminar" Content="Eliminar" Background="#663668"/>
        </StackPanel>

        <DockPanel Margin="5" Grid.Row="2">

            <!-- Criterios de búsqueda -->
            <DockPanel DockPanel.Dock="Top" Margin="5">
                <Label DockPanel.Dock="Left" Content="Buscar en:"
                    VerticalAlignment="Center" Foreground="#1E293B"/>
                <ComboBox DockPanel.Dock="Left" Name="CbCampo"
                        Margin="5" SelectedIndex="0" Width="110"
                        Background="#2563EB" Foreground="White" 
                        FontWeight="SemiBold">
                    <ComboBoxItem>Todos</ComboBoxItem>
                    <ComboBoxItem>DNI</ComboBoxItem>
                    <ComboBoxItem>Nombre</ComboBoxItem>
                    <ComboBoxItem>Email</ComboBoxItem>
                </ComboBox>
                <Button DockPanel.Dock="Right" Name="BtLimpiar"
                        Content="Limpiar" Margin="5" Background="#663668"/>
                <TextBox Name="EdTexto" Margin="5"
                        PlaceholderText="Texto a buscar"
                        Background="#3B82F6" Foreground="White" 
                        FontWeight="SemiBold" />
            </DockPanel>

            <Label DockPanel.Dock="Bottom" Name="LblResultados"
                    Margin="5" Foreground="#1E293B"/>

            <Border Margin="5"
                    BorderThickness="1"
                    CornerRadius="3"
                    BorderBrush="Gray">
                <DataGrid Name="DtResultados"
                        Margin="5"
                        x:CompileBindings="False"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" />
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" />
                        <DataGridTextColumn Header="E.mail" Binding="{Binding Email}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </DockPanel>
    </Grid>
</UserControl>
